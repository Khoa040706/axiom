@startuml
title Hình 6.13 — State Diagram: Trạng thái đơn nghỉ phép
skinparam state {
  BackgroundColor #FEF2F2
  BorderColor #D0211C
}

[*] --> ChoDuyet : Nhân viên tạo đơn
ChoDuyet : status = "Chờ duyệt"
ChoDuyet : Mặc định sau khi tạo

ChoDuyet --> DaDuyet : HR/Manager duyệt\n[quỹ phép đủ]
ChoDuyet --> TuChoi : HR/Manager từ chối

DaDuyet : status = "Đã duyệt"
DaDuyet : Trừ usedDays\ntrong LeaveBalance

TuChoi : status = "Từ chối"
TuChoi : Quỹ phép không bị trừ

DaDuyet --> [*]
TuChoi --> [*]

@enduml
