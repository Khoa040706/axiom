@startuml
title Hình 6.15 — State Diagram: Trạng thái chấm công
skinparam state {
  BackgroundColor #FEF2F2
  BorderColor #D0211C
}

[*] --> ChuaCheckIn : Đầu ngày làm việc
ChuaCheckIn : Chưa ghi nhận\ncheck-in

ChuaCheckIn --> DungGio : Check-in\n[trước 07:30]\n[khoảng cách ≤ 500m]
ChuaCheckIn --> DiMuon : Check-in muộn\n[sau 07:30]
ChuaCheckIn --> VangMat : Hết ngày,\nkhông check-in

DungGio : status = "Đúng giờ"
DungGio : lateMinutes = 0

DiMuon : status = "Đi muộn"
DiMuon : lateMinutes > 0

VangMat : status = "Vắng mặt"

DungGio --> HoanThanh : Check-out
DiMuon --> HoanThanh : Check-out

HoanThanh : Tính netHours, otHours

HoanThanh --> [*]
VangMat --> [*]

@enduml
