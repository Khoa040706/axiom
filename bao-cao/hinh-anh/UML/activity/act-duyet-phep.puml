@startuml
skinparam monochrome true
skinparam shadowing false
title Hình 6.6 — Activity Diagram: Duyệt nghỉ phép
start
:HR/Manager vào /leave;
:Xem danh sách đơn "Chờ duyệt";
:Chọn đơn cần xử lý;
if (Quyết định?) then (Từ chối)
  :Cập nhật status = "Từ chối";
  :Ghi approvedBy + timestamp;
  stop
else (Duyệt)
endif
:Kiểm tra LeaveBalance;
if (Quỹ phép đủ?) then (Không đủ)
  :Trả lỗi: Không thể duyệt\n(quỹ phép không đủ);
  stop
else (Đủ)
endif
:BEGIN TRANSACTION;
:Cập nhật status = "Đã duyệt";
:Trừ usedDays trong LeaveBalance;
:Ghi approvedBy + timestamp;
:COMMIT;
:Cập nhật giao diện;
stop
@enduml
