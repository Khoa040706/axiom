@startuml
title Hình 6.7 — Activity Diagram: Tính lương tự động
start
:Kế toán vào /payroll;
:Chọn tháng/năm;
:Nhấn "Tính lương tự động";
:Lấy danh sách NV (status: Đang làm / Thử việc);
while (Còn nhân viên?) is (Có)
  if (Có hợp đồng hiệu lực?) then (Không)
    :Bỏ qua, ghi log lỗi;
  else (Có)
    :Lấy dữ liệu chấm công tháng;
    :Tính ngày công + otHours;
    :Gross = Lương CB × Hệ số\n+ Phụ cấp + OT Pay;
    :BH = BHXH(8%) + BHYT(1.5%)\n+ BHTN(1%);
    :Tính thuế TNCN\n(biểu lũy tiến 7 bậc);
    :Net = Gross - BH - Thuế;
    :Lưu Payroll + Tạo Payslip;
  endif
endwhile (Không)
:Báo cáo kết quả:\n"Đã tính X/Y nhân viên";
stop
@enduml
