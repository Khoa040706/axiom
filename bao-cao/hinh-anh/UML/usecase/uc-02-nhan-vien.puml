@startuml
title Hình 4.3 — Sơ đồ Use Case UC-02\nPhân hệ Quản lý nhân viên
skinparam usecase {
  BackgroundColor #FEF2F2
  BorderColor #D0211C
  ArrowColor #D0211C
  ActorBorderColor #991414
  ActorFontStyle Bold
}
skinparam packageStyle rectangle
left to right direction

actor "Admin" as Admin
actor "HRManager" as HR

rectangle "UC-02 — Phân hệ Quản lý nhân viên" {
  usecase "UC-02.1\nXem danh sách\nnhân viên" as UC1
  usecase "UC-02.2\nThêm nhân viên\nmới" as UC2
  usecase "UC-02.3\nSửa thông tin\nnhân viên" as UC3
  usecase "UC-02.4\nXóa mềm\nnhân viên" as UC4
  usecase "UC-02.5\nKhôi phục\nnhân viên" as UC5

  usecase "Validate\nZod schema" as INC1
  usecase "Lọc / Tìm\nkiếm" as INC2
}

Admin --> UC1
Admin --> UC2
Admin --> UC3
Admin --> UC4
Admin --> UC5

HR --> UC1
HR --> UC2
HR --> UC3
HR --> UC4
HR --> UC5

UC1 ..> INC2 : <<include>>
UC2 ..> INC1 : <<include>>
UC3 ..> INC1 : <<include>>

note bottom of UC2
  Dữ liệu không hợp lệ
  → hiển thị lỗi validation
end note

note bottom of UC4
  Soft delete:
  status → "Đã nghỉ"
end note

@enduml
