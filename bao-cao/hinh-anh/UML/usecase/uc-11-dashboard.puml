@startuml
skinparam monochrome true
skinparam shadowing false
title Hình 4.12 — Sơ đồ Use Case UC-11\nPhân hệ Dashboard & Báo cáo

skinparam packageStyle rectangle
left to right direction

actor "Director" as DIR
actor "HRManager" as HR
actor "Accountant" as ACC

rectangle "UC-11 — Phân hệ Dashboard & Báo cáo" {
  usecase "UC-11.1\nDashboard\nDirector" as UC1
  usecase "UC-11.2\nXuất báo cáo\nPDF" as UC2
  usecase "UC-11.3\nDashboard\nHR Manager" as UC3
  usecase "UC-11.4\nDashboard\nAccountant" as UC4

  usecase "Thống kê\nHeadcount +\nPayroll trend" as INC1
  usecase "Thống kê\nnhân sự" as INC2
  usecase "Thống kê\ntài chính / lương" as INC3
  usecase "Tạo PDF\n(jsPDF + autoTable)" as INC4
}

DIR --> UC1
DIR --> UC2
HR --> UC3
HR --> UC2
ACC --> UC4
ACC --> UC2

UC1 ..> INC1 : <<include>>
UC2 ..> INC4 : <<include>>
UC3 ..> INC2 : <<include>>
UC4 ..> INC3 : <<include>>

note right of UC1
  Biểu đồ: Headcount trend,
  Payroll Gross/Net,
  Attendance rate,
  Leave overview,
  New hires
end note

@enduml
