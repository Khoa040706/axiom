@startuml
title Hình 4.11 — Sơ đồ Use Case UC-10\nPhân hệ Quản lý tài khoản & Phân quyền (RBAC)
skinparam usecase {
  BackgroundColor #FEF2F2
  BorderColor #D0211C
  ArrowColor #D0211C
  ActorBorderColor #991414
  ActorFontStyle Bold
}
skinparam packageStyle rectangle
left to right direction

actor "Admin" as Admin

rectangle "UC-10 — Phân hệ Quản lý tài khoản (RBAC)" {
  usecase "UC-10.1\nTạo tài khoản" as UC1
  usecase "UC-10.2\nĐổi role\n(phân quyền)" as UC2
  usecase "UC-10.3\nKích hoạt /\nVô hiệu hóa" as UC3
  usecase "UC-10.4\nReset mật khẩu\n(Admin)" as UC4
  usecase "UC-10.5\nXóa tài khoản" as UC5

  usecase "Hash bcrypt\n(10 rounds)" as INC1
  usecase "Tạo Employee\nliên kết (transaction)" as INC2
  usecase "Kiểm tra ràng\nbuộc thăng/hạ" as INC3
  usecase "Soft-delete\nEmployee" as INC4
}

Admin --> UC1
Admin --> UC2
Admin --> UC3
Admin --> UC4
Admin --> UC5

UC1 ..> INC1 : <<include>>
UC1 ..> INC2 : <<include>>
UC4 ..> INC1 : <<include>>
UC2 ..> INC3 : <<include>>
UC5 ..> INC4 : <<include>>

note right of UC2
  Ràng buộc:
  Employee → Manager (thăng)
  Manager → Employee (hạ)
  Không thể đổi sang
  Admin/Director/HR/Acc
end note

@enduml
