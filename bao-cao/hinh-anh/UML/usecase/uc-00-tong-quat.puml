@startuml
title Hình 4.1 — Sơ đồ Use Case Tổng quát\nHệ thống Axiom HRM

skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowThickness 1

skinparam packageStyle rectangle
skinparam packageFontSize 12
skinparam packageFontStyle bold
skinparam linetype ortho
left to right direction

' ── BÊN TRÁI ──
actor "Employee\n(Nhân viên)" as EMP
actor "Manager\n(Trưởng phòng)" as MGR
actor "Director\n(Giám đốc)" as DIR

rectangle "Axiom HRM System" {

  package "Xác thực" {
    usecase "Đăng nhập" as UC_LOGIN
    usecase "Đăng xuất" as UC_LOGOUT
    usecase "Quên mật khẩu" as UC_FORGOT
  }

  package "Chấm công" {
    usecase "Check-in GPS" as UC_CHECKIN
    usecase "Check-out" as UC_CHECKOUT
    usecase "Xem bảng chấm công" as UC_ATT_VIEW
  }

  package "Nghỉ phép" {
    usecase "Đăng ký nghỉ phép" as UC_LEAVE_REQ
    usecase "Duyệt nghỉ phép" as UC_LEAVE_APR
    usecase "Xem quỹ phép" as UC_LEAVE_BAL
  }

  package "Công tác phí" {
    usecase "Đăng ký công tác" as UC_TRIP_REQ
    usecase "Duyệt công tác" as UC_TRIP_APR
  }

  package "Phiếu lương" {
    usecase "Xem phiếu lương" as UC_SLIP_VIEW
    usecase "Tải PDF phiếu lương" as UC_SLIP_PDF
  }

  package "Quản lý nhân viên" {
    usecase "Xem danh sách NV" as UC_EMP_LIST
    usecase "Thêm / Sửa / Xóa NV" as UC_EMP_CRUD
  }

  package "Quản lý hợp đồng" {
    usecase "Tạo hợp đồng" as UC_CONTRACT
    usecase "Thanh lý hợp đồng" as UC_CONTRACT_END
  }

  package "Quá trình công tác" {
    usecase "Tạo sự kiện nhân sự" as UC_CAREER
    usecase "Xem lịch sử công tác" as UC_CAREER_VIEW
  }

  package "Tính lương" {
    usecase "Tính lương tự động" as UC_PAY_CALC
    usecase "Cấu hình tham số" as UC_PAY_CFG
    usecase "Xác nhận chi lương" as UC_PAY_CON
  }

  package "Quản lý tài khoản" {
    usecase "Tạo / Xóa tài khoản" as UC_USER_MGMT
    usecase "Đổi role / Phân quyền" as UC_ROLE
    usecase "Reset mật khẩu" as UC_RESET
  }

  package "Dashboard & Báo cáo" {
    usecase "Dashboard Dir / Manager" as UC_DASH_FRONT
    usecase "Dashboard HR" as UC_DASH_HR
    usecase "Dashboard Accountant" as UC_DASH_ACC
    usecase "Xuất PDF / Excel" as UC_EXPORT
  }
}

' ── BÊN PHẢI (đảo chiều mũi tên: UC --> Actor) ──
actor "Admin" as ADMIN
actor "HR Manager\n(Nhân sự)" as HR
actor "Accountant\n(Kế toán)" as ACC

' ── Liên kết TRÁI (Actor --> UC) ──
EMP --> UC_LOGIN
EMP --> UC_LOGOUT
EMP --> UC_FORGOT
EMP --> UC_CHECKIN
EMP --> UC_CHECKOUT
EMP --> UC_ATT_VIEW
EMP --> UC_LEAVE_REQ
EMP --> UC_LEAVE_BAL
EMP --> UC_TRIP_REQ
EMP --> UC_SLIP_VIEW
EMP --> UC_SLIP_PDF

MGR --> UC_ATT_VIEW
MGR --> UC_LEAVE_APR
MGR --> UC_TRIP_APR
MGR --> UC_DASH_FRONT

DIR --> UC_LOGIN
DIR --> UC_LOGOUT
DIR --> UC_DASH_FRONT
DIR --> UC_EXPORT

' ── Liên kết PHẢI (UC --> Actor) ──
UC_LOGIN --> ADMIN
UC_LOGIN --> HR
UC_LOGIN --> ACC
UC_LOGOUT --> ADMIN
UC_LOGOUT --> HR
UC_LOGOUT --> ACC

UC_USER_MGMT --> ADMIN
UC_ROLE --> ADMIN
UC_RESET --> ADMIN
UC_PAY_CFG --> ADMIN
UC_EMP_LIST --> ADMIN
UC_EMP_CRUD --> ADMIN
UC_CONTRACT --> ADMIN
UC_CONTRACT_END --> ADMIN
UC_CAREER --> ADMIN
UC_CAREER_VIEW --> ADMIN

UC_EMP_LIST --> HR
UC_EMP_CRUD --> HR
UC_CONTRACT --> HR
UC_CONTRACT_END --> HR
UC_ATT_VIEW --> HR
UC_LEAVE_APR --> HR
UC_TRIP_APR --> HR
UC_CAREER --> HR
UC_CAREER_VIEW --> HR
UC_DASH_HR --> HR
UC_EXPORT --> HR

UC_PAY_CALC --> ACC
UC_PAY_CFG --> ACC
UC_PAY_CON --> ACC
UC_SLIP_VIEW --> ACC
UC_SLIP_PDF --> ACC
UC_DASH_ACC --> ACC
UC_EXPORT --> ACC

@enduml
