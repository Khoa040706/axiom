@startuml
title Hình 4.6 — Sơ đồ Use Case UC-05\nPhân hệ Nghỉ phép
skinparam usecase {
  BackgroundColor #FEF2F2
  BorderColor #D0211C
  ArrowColor #D0211C
  ActorBorderColor #991414
  ActorFontStyle Bold
}
skinparam packageStyle rectangle
left to right direction

actor "Employee" as EMP
actor "HRManager" as HR
actor "Manager" as MGR

rectangle "UC-05 — Phân hệ Nghỉ phép" {
  usecase "UC-05.1\nĐăng ký\nnghỉ phép" as UC1
  usecase "UC-05.2\nDuyệt đơn\nnghỉ phép" as UC2
  usecase "UC-05.3\nTừ chối đơn\nnghỉ phép" as UC3
  usecase "UC-05.4\nXem quỹ phép" as UC4

  usecase "Tính số ngày\n(trừ T7, CN)" as INC1
  usecase "Kiểm tra\nquỹ phép" as INC2
  usecase "Trừ usedDays\n(transaction)" as INC3
}

EMP --> UC1
EMP --> UC4
HR --> UC2
HR --> UC3
HR --> UC4
MGR --> UC2
MGR --> UC3

UC1 ..> INC1 : <<include>>
UC1 ..> INC2 : <<include>>
UC2 ..> INC2 : <<include>>
UC2 ..> INC3 : <<include>>

note right of UC1
  Quỹ phép không đủ
  → cảnh báo & chặn gửi
end note

note right of UC2
  Quỹ phép không đủ
  → lỗi, không cập nhật
end note

@enduml
