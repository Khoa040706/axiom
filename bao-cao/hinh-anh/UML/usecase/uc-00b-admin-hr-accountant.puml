@startuml uc-00b-admin-hr-accountant
title Hình 4.1b — Use Case Tổng quát (Phần 2)\nAdmin · HR Manager · Accountant

skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial

skinparam packageStyle rectangle
skinparam linetype ortho
left to right direction

actor "Admin" as ADMIN
actor "HR Manager\n(Nhân sự)" as HR
actor "Accountant\n(Kế toán)" as ACC

rectangle "Axiom HRM — Phần 2" {

  package "Xác thực" {
    usecase "Đăng nhập" as UC_LOGIN
    usecase "Đăng xuất" as UC_LOGOUT
  }

  package "Quản lý tài khoản" {
    usecase "Tạo / Xóa tài khoản" as UC_USER_MGMT
    usecase "Đổi role / Phân quyền" as UC_ROLE
    usecase "Reset mật khẩu" as UC_RESET
  }

  package "Quản lý nhân viên" {
    usecase "Xem danh sách NV" as UC_EMP_LIST
    usecase "Thêm / Sửa / Xóa NV" as UC_EMP_CRUD
  }

  package "Quản lý hợp đồng" {
    usecase "Tạo hợp đồng" as UC_CONTRACT
    usecase "Thanh lý hợp đồng" as UC_CONTRACT_END
  }

  package "Quá trình công tác" {
    usecase "Tạo sự kiện nhân sự" as UC_CAREER
    usecase "Xem lịch sử công tác" as UC_CAREER_VIEW
  }

  package "Chấm công (HR)" {
    usecase "Xem / Sửa bảng chấm công" as UC_ATT_ADMIN
    usecase "Duyệt nghỉ phép" as UC_LEAVE_APR
  }

  package "Tính lương" {
    usecase "Tính lương tự động" as UC_PAY_CALC
    usecase "Cấu hình tham số lương" as UC_PAY_CFG
    usecase "Xác nhận chi lương" as UC_PAY_CON
    usecase "Xem phiếu lương NV" as UC_SLIP_VIEW
  }

  package "Dashboard & Báo cáo" {
    usecase "Dashboard HR" as UC_DASH_HR
    usecase "Dashboard Accountant" as UC_DASH_ACC
    usecase "Xuất PDF / Excel" as UC_EXPORT
  }
}

' Auth
ADMIN --> UC_LOGIN
HR --> UC_LOGIN
ACC --> UC_LOGIN
ADMIN --> UC_LOGOUT
HR --> UC_LOGOUT
ACC --> UC_LOGOUT

' Account management (Admin only)
ADMIN --> UC_USER_MGMT
ADMIN --> UC_ROLE
ADMIN --> UC_RESET

' Employee
ADMIN --> UC_EMP_LIST
ADMIN --> UC_EMP_CRUD
HR --> UC_EMP_LIST
HR --> UC_EMP_CRUD

' Contract
ADMIN --> UC_CONTRACT
ADMIN --> UC_CONTRACT_END
HR --> UC_CONTRACT
HR --> UC_CONTRACT_END

' Career history
ADMIN --> UC_CAREER
ADMIN --> UC_CAREER_VIEW
HR --> UC_CAREER
HR --> UC_CAREER_VIEW

' Attendance
HR --> UC_ATT_ADMIN
HR --> UC_LEAVE_APR

' Payroll
ACC --> UC_PAY_CALC
ACC --> UC_PAY_CFG
ADMIN --> UC_PAY_CFG
ACC --> UC_PAY_CON
ACC --> UC_SLIP_VIEW

' Dashboard
HR --> UC_DASH_HR
ACC --> UC_DASH_ACC
HR --> UC_EXPORT
ACC --> UC_EXPORT

@enduml
