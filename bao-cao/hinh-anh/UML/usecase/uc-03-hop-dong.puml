@startuml
title Hình 4.4 — Sơ đồ Use Case UC-03\nPhân hệ Quản lý hợp đồng lao động
skinparam usecase {
  BackgroundColor #FEF2F2
  BorderColor #D0211C
  ArrowColor #D0211C
  ActorBorderColor #991414
  ActorFontStyle Bold
}
skinparam packageStyle rectangle
left to right direction

actor "Admin" as Admin
actor "HRManager" as HR

rectangle "UC-03 — Phân hệ Quản lý hợp đồng" {
  usecase "UC-03.1\nXem danh sách\nhợp đồng" as UC1
  usecase "UC-03.2\nTạo hợp đồng\nmới" as UC2
  usecase "UC-03.3\nThanh lý\nhợp đồng" as UC3
  usecase "UC-03.4\nXem HĐ sắp\nhết hạn" as UC4

  usecase "Validate\nZod schema" as INC1
  usecase "Cảnh báo\nhết hạn (30 ngày)" as EXT1
}

Admin --> UC1
Admin --> UC2
Admin --> UC3
Admin --> UC4
HR --> UC1
HR --> UC2
HR --> UC3
HR --> UC4

UC2 ..> INC1 : <<include>>
UC4 ..> EXT1 : <<extend>>

note right of UC2
  Nhân viên đã có HĐ hiệu lực
  → cảnh báo trước khi tạo
end note

note right of UC3
  status → "Đã thanh lý"
end note

@enduml
