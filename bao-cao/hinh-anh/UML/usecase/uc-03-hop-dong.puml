@startuml
skinparam monochrome true
skinparam shadowing false
title Hình 4.4 — Sơ đồ Use Case UC-03\nPhân hệ Quản lý Hợp đồng Lao động

skinparam packageStyle rectangle
skinparam defaultFontName Arial
skinparam usecase {
  BorderThickness 1.5
  FontSize 11
}
left to right direction

actor "Admin" as Admin
actor "HR Manager\n(Nhân sự)" as HR

rectangle "UC-03 — Phân hệ Quản lý Hợp đồng" {

  usecase "UC-03.1\nXem danh sách\nhợp đồng" as UC1
  usecase "UC-03.2\nTạo hợp đồng\nmới" as UC2
  usecase "UC-03.3\nThanh lý\nhợp đồng" as UC3
  usecase "UC-03.4\nXem HĐ sắp\nhết hạn" as UC4

  usecase "Lọc / Tìm\nkiếm" as INC_FILTER
  usecase "Validate\nZod schema" as INC_VALID
  usecase "Cảnh báo\nhết hạn (30 ngày)" as EXT_WARN
}

' Actor -> Use case
Admin --> UC1
Admin --> UC2
Admin --> UC3
Admin --> UC4

HR --> UC1
HR --> UC2
HR --> UC3
HR --> UC4

' Relationships
UC1 ..> INC_FILTER : <<include>>
UC2 ..> INC_VALID  : <<include>>
UC3 ..> INC_VALID  : <<include>>
UC4 ..> EXT_WARN   : <<extend>>

@enduml
