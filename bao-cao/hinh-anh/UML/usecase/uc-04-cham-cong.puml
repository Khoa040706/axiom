@startuml
skinparam monochrome true
skinparam shadowing false
title Hình 4.5 — Sơ đồ Use Case UC-04\nPhân hệ Chấm công GPS

skinparam packageStyle rectangle
skinparam defaultFontName Arial
skinparam usecase {
  BorderThickness 1.5
  FontSize 11
}
left to right direction

actor "Employee" as EMP
actor "HRManager" as HR
actor "Manager" as MGR

rectangle "UC-04 — Phân hệ Chấm công" {
  usecase "UC-04.1\nCheck-in GPS" as UC1
  usecase "UC-04.2\nCheck-out" as UC2
  usecase "UC-04.3\nXem bảng chấm\ncông tháng" as UC3
  usecase "UC-04.4\nXuất Excel\nchấm công" as UC4

  usecase "Xác minh vị trí\nGPS ≤ 500m" as INC_GPS
  usecase "Tính lateMinutes\nso với 07:30" as INC_LATE
  usecase "Tính otHours\n(> 8 giờ)" as INC_OT
  usecase "Lọc theo\ntháng / năm" as INC_FILTER
  usecase "Xuất file .xlsx\n(ExcelJS)" as INC_EXPORT
  usecase "Từ chối\nngoài khu vực" as EXT_REJECT
}

EMP --> UC1
EMP --> UC2
HR --> UC3
HR --> UC4
MGR --> UC3

UC1 ..> INC_GPS    : <<include>>
UC1 ..> INC_LATE   : <<include>>
UC2 ..> INC_OT     : <<include>>
UC3 ..> INC_FILTER : <<include>>
UC4 ..> INC_EXPORT : <<include>>
EXT_REJECT ..> UC1 : <<extend>>

@enduml
