@startuml
skinparam monochrome true
skinparam shadowing false
title Hình 6.11 — Sequence Diagram: Duyệt nghỉ phép
actor "HR/Manager" as MGR
participant "UI /leave" as UI
participant "LeaveService" as SVC
database "PostgreSQL" as DB

MGR -> UI : Xem danh sách đơn\n"Chờ duyệt"
UI -> DB : SELECT leaveRequests\nWHERE status='Chờ duyệt'
DB --> UI : [leave requests]
UI --> MGR : Hiển thị danh sách
MGR -> UI : Nhấn "Duyệt" (leaveId)
UI -> SVC : approveLeave\n(id, approverId, true)
SVC -> DB : SELECT LeaveBalance\nWHERE employeeId, leaveType
DB --> SVC : {totalDays, usedDays}
alt Không đủ quỹ phép
  SVC --> UI : Error: Không đủ quỹ phép
  UI --> MGR : Hiển thị lỗi
else Đủ quỹ phép
  SVC -> DB : BEGIN TRANSACTION
  SVC -> DB : UPDATE LeaveRequest\nSET status='Đã duyệt'
  SVC -> DB : UPDATE LeaveBalance\nSET usedDays += totalDays
  SVC -> DB : COMMIT
  DB --> SVC : OK
  SVC --> UI : Success
  UI --> MGR : Cập nhật giao diện
end
@enduml
