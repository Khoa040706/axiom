@startuml
title Hình 6.8 — Sequence Diagram: Đăng nhập
actor "Người dùng" as U
participant "Browser" as B
participant "Middleware" as MW
participant "NextAuth" as NA
database "PostgreSQL" as DB

U -> B : Nhập username & password
B -> NA : POST /api/auth/signin
NA -> DB : SELECT user WHERE username=?
DB --> NA : User record
NA -> NA : bcrypt.compare(password, hash)
alt Sai thông tin
  NA --> B : Error: Sai thông tin
  B --> U : Hiển thị lỗi
else Tài khoản khóa
  NA --> B : Error: Tài khoản bị khóa
  B --> U : Hiển thị lỗi khóa
else Hợp lệ
  NA -> NA : Tạo JWT token\n(role, employeeId, name)
  NA --> B : Set-Cookie: session
  B -> MW : Truy cập dashboard
  MW -> MW : Kiểm tra session + role
  MW --> B : Redirect theo role
  B --> U : Hiển thị Dashboard
end
@enduml
