@startuml
title Hình 6.9 — Sequence Diagram: Check-in GPS
actor "Employee" as E
participant "Browser" as B
participant "Geolocation API" as GEO
participant "Next.js API" as API
database "PostgreSQL" as DB

E -> B : Vào /attendance/check-in
B -> GEO : getCurrentPosition()
alt Từ chối GPS
  GEO --> B : Error: Permission denied
  B --> E : Thông báo lỗi GPS
else Cho phép
  GEO --> B : {lat, lng}
  B -> B : Haversine(lat,lng,\noffice_lat, office_lng)
  alt Ngoài 500m
    B --> E : Badge đỏ:\n"Ngoài khu vực (~Xm)"
  else Trong 500m
    B --> E : Badge xanh:\n"Trong khu vực"
    E -> B : Nhấn Check-in
    B -> API : POST /api/attendance/checkin
    API -> DB : INSERT Attendance\n(employeeId, workDate, checkIn)
    API -> API : lateMinutes =\nmax(0, checkIn - 07:30)
    API -> DB : UPDATE status\n(Đúng giờ / Đi muộn)
    DB --> API : OK
    API --> B : {success, lateMinutes}
    B --> E : Timer bắt đầu đếm
  end
end
@enduml
