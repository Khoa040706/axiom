@startuml
title Hình 6.10 — Sequence Diagram: Tính lương tự động
actor "Accountant" as ACC
participant "UI /payroll" as UI
participant "PayrollService" as SVC
database "PostgreSQL" as DB

ACC -> UI : Chọn tháng/năm\n→ Nhấn "Tính lương"
UI -> SVC : calculatePayrollBatch\n(month, year)
SVC -> DB : SELECT employees\nWHERE status IN (active)
DB --> SVC : [employees]
loop Từng nhân viên
  SVC -> DB : SELECT contract\nWHERE isActive=true
  alt Không có hợp đồng
    SVC -> SVC : Ghi log lỗi, bỏ qua
  else Có hợp đồng
    SVC -> DB : SELECT attendance\nWHERE month/year
    DB --> SVC : [attendance records]
    SVC -> SVC : Tính workDays, otHours
    SVC -> SVC : Gross = baseSalary×grade\n+ allowance + otPay
    SVC -> SVC : BH = BHXH(8%)\n+ BHYT(1.5%) + BHTN(1%)
    SVC -> SVC : Thuế TNCN lũy tiến
    SVC -> SVC : Net = Gross - BH - Thuế
    SVC -> DB : UPSERT Payroll\n+ INSERT Payslip
  end
end
SVC --> UI : {success: X, failed: Y}
UI --> ACC : Thông báo kết quả
@enduml
